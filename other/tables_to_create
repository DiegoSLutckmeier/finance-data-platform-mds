DROP TABLE IF EXISTS BRONZE.STRIPE_CHARGES;
DROP TABLE IF EXISTS BRONZE.STRIPE_BALANCE_TRANSACTIONS;
DROP TABLE IF EXISTS BRONZE.STRIPE_BALANCE;
DROP TABLE IF EXISTS BRONZE.STRIPE_PAYOUTS;


CREATE TABLE BRONZE.STRIPE_CUSTOMERS (
    -- Stripe identifiers
    CUSTOMER_ID      STRING,
    OBJECT_TYPE      STRING,

    -- Full raw Stripe object
    RAW_PAYLOAD      VARIANT,

    -- Lineage & audit
    INGESTED_AT      TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP(),
    SOURCE_SYSTEM   STRING DEFAULT 'stripe'
);


CREATE TABLE BRONZE.STRIPE_CUSTOMERS (
