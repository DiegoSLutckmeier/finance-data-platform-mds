CREATE OR REPLACE TABLE BRONZE.STRIPE_BALANCE (
    BALANCE_ID         STRING        DEFAULT UUID_STRING(),
    OBJECT_TYPE        STRING,        -- e.g. "balance"
    LIVEMODE           BOOLEAN,

    -- Nested Stripe arrays (kept as-is)
    AVAILABLE          VARIANT,       -- array of {amount, currency, source_types}
    PENDING            VARIANT,
    CONNECT_RESERVED   VARIANT,

    -- Full original API payload for audit & replay
    RAW_PAYLOAD        VARIANT,

    -- Ingestion metadata
    INGESTED_AT        TIMESTAMP_NTZ  DEFAULT CURRENT_TIMESTAMP(),
    -- Updated timestamp
    UPDATED_AT         TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
);


CREATE OR REPLACE TABLE BRONZE.STRIPE_PAYMENT_INTENTS (
    PAYMENT_INTENT_ID      STRING,
    OBJECT_TYPE            STRING,

    -- Monetary fields (in minor units, e.g. cents)
    AMOUNT                 NUMBER,
    AMOUNT_CAPTURABLE      NUMBER,
    AMOUNT_RECEIVED        NUMBER,
    CURRENCY               STRING,

    -- Status & lifecycle
    STATUS                 STRING,
    CAPTURE_METHOD         STRING,
    CONFIRMATION_METHOD    STRING,
    CREATED_AT             TIMESTAMP_NTZ,
    LIVEMODE               BOOLEAN,

    -- Relationships
    CUSTOMER_ID            STRING,
    LATEST_CHARGE_ID       STRING,
    PAYMENT_METHOD_ID      STRING,

    -- Nested Stripe objects
    AMOUNT_DETAILS         VARIANT,
    AUTOMATIC_PAYMENT_METHODS VARIANT,
    PAYMENT_METHOD_OPTIONS VARIANT,
    PAYMENT_METHOD_TYPES   VARIANT,
    METADATA               VARIANT,
    LAST_PAYMENT_ERROR     VARIANT,
    NEXT_ACTION            VARIANT,
    TRANSFER_DATA          VARIANT,

    -- Full original payload
    RAW_PAYLOAD            VARIANT,

    -- Ingestion metadata
    INGESTED_AT            TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP(),
    -- Updated timestamp
    UPDATED_AT             TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
);




CREATE OR REPLACE TABLE BRONZE.STRIPE_CHARGES (
    CHARGE_ID                 STRING,
    OBJECT_TYPE               STRING,

    -- Money
    AMOUNT                    NUMBER,
    AMOUNT_CAPTURED           NUMBER,
    AMOUNT_REFUNDED           NUMBER,
    CURRENCY                  STRING,

    -- Status
    PAID                      BOOLEAN,
    CAPTURED                  BOOLEAN,
    REFUNDED                  BOOLEAN,
    DISPUTED                  BOOLEAN,
    STATUS                    STRING,
    LIVEMODE                  BOOLEAN,

    -- Relationships
    PAYMENT_INTENT_ID         STRING,
    PAYMENT_METHOD_ID         STRING,
    CUSTOMER_ID               STRING,
    BALANCE_TRANSACTION_ID   STRING,

    -- Timing
    CREATED_AT                TIMESTAMP_NTZ,

    -- Stripe nested objects
    BILLING_DETAILS           VARIANT,
    OUTCOME                   VARIANT,
    FRAUD_DETAILS             VARIANT,
    PAYMENT_METHOD_DETAILS    VARIANT,
    METADATA                  VARIANT,
    SHIPPING                  VARIANT,

    -- URLs & descriptors
    RECEIPT_URL               STRING,
    STATEMENT_DESCRIPTOR     STRING,
    STATEMENT_DESCRIPTOR_SUFFIX STRING,

    -- Full payload
    RAW_PAYLOAD               VARIANT,

    INGESTED_AT               TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP(),
    -- Updated timestamp
    UPDATED_AT             TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
);


